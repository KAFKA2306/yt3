[Unit]
Description=YT3 Humanity Observatory Daily Music Video
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=300
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/home/kafka/.local/bin:/home/kafka/.bun/bin:/snap/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/kafka
ExecStart=/usr/bin/bash -c 'exec >> logs/humanity_music_daily.log 2>&1; task humanity:music-daily DATE=$(date +%%F) || { DISCORD_ALERT_TYPE=audit_fail DISCORD_ALERT_MESSAGE="Humanity music daily failed" bun src/scripts/send_discord_alert.ts; exit 1; }'
