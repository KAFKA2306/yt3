[Unit]
Description=YT3 Byosan 0-Token Market Regime Watch (US Close Trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=50m
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/home/kafka/.local/bin:/home/kafka/.bun/bin:/snap/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/kafka
ExecStart=/usr/bin/bash -c 'exec >> logs/byosan_regime_watch.log 2>&1; task byosan:regime-watch -- --trigger'
