[Unit]
Description=Timer for YT3 Humanity Observatory Music Video

[Timer]
OnCalendar=*-*-* 03:30:00
OnCalendar=*-*-* 06:30:00
OnCalendar=*-*-* 10:30:00
OnCalendar=*-*-* 13:30:00
OnCalendar=*-*-* 16:30:00
OnCalendar=*-*-* 22:30:00
Persistent=true
Unit=yt3-humanity-music.service

[Install]
WantedBy=timers.target
