[Unit]
Description=YT3 Yawa Archive Daily ASMR Episode
After=network-online.target
StartLimitIntervalSec=7200
StartLimitBurst=3

[Service]
Type=oneshot
Restart=on-failure
RestartSec=600
TimeoutStartSec=5400
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/home/kafka/.local/bin:/home/kafka/.bun/bin:/snap/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/kafka
Environment=HF_HOME=/home/kafka/.cache/hf-yawa
ExecStart=/usr/bin/bash -c 'exec >> logs/yawa_daily.log 2>&1; task yawa:daily DATE=$(date +%%F) || { DISCORD_ALERT_TYPE=audit_fail DISCORD_ALERT_MESSAGE="Yawa daily failed" bun src/scripts/send_discord_alert.ts; exit 1; }'
