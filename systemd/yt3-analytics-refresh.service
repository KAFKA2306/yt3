[Unit]
Description=YT3 Daily YouTube Analytics Refresh
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=30m
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/home/kafka/.local/bin:/home/kafka/.bun/bin:/snap/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/kafka
ExecStart=/usr/bin/bash -c 'exec >> logs/analytics_refresh.log 2>&1; task analytics:refresh && task analytics:build'
