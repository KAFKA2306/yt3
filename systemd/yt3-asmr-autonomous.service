[Unit]
Description=YT3 ASMR Autonomous Management Service
After=network.target

[Service]
Type=oneshot
User=kafka
Group=kafka
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/root/.nvm/versions/node/v22.17.1/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/kafka/2511youtuber/v3/yt3/scripts/run_gemini_asmr_12h.sh
StandardOutput=append:/home/kafka/2511youtuber/v3/yt3/logs/gemini_asmr_12h.log
StandardError=append:/home/kafka/2511youtuber/v3/yt3/logs/gemini_asmr_12h.log

[Install]
WantedBy=default.target
