[Unit]
Description=YT3 Resident Agent Autonomous Ops Tick (Kafstyler)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=10m
WorkingDirectory=/home/kafka/2511youtuber/v3/yt3
Environment=PATH=/home/kafka/.local/bin:/home/kafka/.bun/bin:/snap/bin:/usr/lib/wsl/lib:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/kafka
ExecStart=/usr/bin/bash -c 'exec >> logs/resident_systemd.log 2>&1; task resident:tick'
