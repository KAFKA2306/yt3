{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "python3 hooks/prompt_boundary_guard.py --phase pre"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "python3 hooks/prompt_boundary_guard.py --phase post"
					},
					{
						"type": "command",
						"command": "bash -c 'FILE=$(jq -r \".tool_input.file_path // .tool_input.path\" <<< \"$(cat)\"); if [[ \"$FILE\" == *.ts ]]; then task lint 2>&1 | head -n 20; fi'"
					}
				]
			}
		]
	}
}
