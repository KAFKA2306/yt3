{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/*.md",
			"!**/*.yaml",
			"!**/*.yml",
			"!**/*.log",
			"!**/logs",
			"!**/node_modules",
			"!**/.venv",
			"!**/.artifacts",
			"!**/artifacts",
			"!**/config/design/foundation.tokens.json",
			"!**/config/design/byosan_video_system_v1.json",
			"!**/data",
			"!**/sbg-nav-audit/snapshots"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
