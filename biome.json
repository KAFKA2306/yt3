{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"files": {
		"ignore": [
			"**/*.log",
			"logs/**",
			"node_modules/**",
			".venv/**",
			".artifacts/**",
			"artifacts/**",
			"config/design/foundation.tokens.json",
			"config/design/byosan_video_system_v1.json",
			"data/**",
			"sbg-nav-audit/snapshots/**"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
