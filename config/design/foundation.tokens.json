{
  "color": {
    "light": {
      "$type": "color",
      "canvas": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.968627,
            0.960784,
            0.937255
          ],
          "alpha": 1,
          "hex": "#F7F5EF"
        }
      },
      "surface": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1,
            1,
            1
          ],
          "alpha": 1,
          "hex": "#FFFFFF"
        }
      },
      "foreground": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.090196,
            0.137255,
            0.247059
          ],
          "alpha": 1,
          "hex": "#17233F"
        }
      },
      "mutedForeground": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.560784,
            0.631373,
            0.701961
          ],
          "alpha": 1,
          "hex": "#8FA1B3"
        }
      },
      "border": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.560784,
            0.631373,
            0.701961
          ],
          "alpha": 1,
          "hex": "#8FA1B3"
        }
      },
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.482353,
            0.654902,
            0.882353
          ],
          "alpha": 1,
          "hex": "#7BA7E1"
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.721569,
            0.654902,
            0.901961
          ],
          "alpha": 1,
          "hex": "#B8A7E6"
        }
      },
      "accent": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.968627,
            0.717647,
            0.756863
          ],
          "alpha": 1,
          "hex": "#F7B7C1"
        }
      },
      "success": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.658824,
            0.835294,
            0.729412
          ],
          "alpha": 1,
          "hex": "#A8D5BA"
        }
      },
      "warning": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            0.847059,
            0.658824
          ],
          "alpha": 1,
          "hex": "#FFD8A8"
        }
      },
      "neutral": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.560784,
            0.631373,
            0.701961
          ],
          "alpha": 1,
          "hex": "#8FA1B3"
        }
      },
      "danger": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.72549,
            0.109804,
            0.109804
          ],
          "alpha": 1,
          "hex": "#B91C1C"
        }
      },
      "focus": {
        "$value": "{color.light.primary}"
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "space1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "space2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "space3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "space4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "radius": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "tableRow": {
      "$value": {
        "value": 30,
        "unit": "px"
      }
    },
    "controlHeight": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "touchTarget": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    },
    "sidebar": {
      "$value": {
        "value": 192,
        "unit": "px"
      }
    },
    "sidebarCollapsed": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "appBar": {
      "$value": {
        "value": 44,
        "unit": "px"
      }
    }
  },
  "number": {
    "$type": "number",
    "shadowOpacity": {
      "$value": 0
    },
    "motionFastMs": {
      "$value": 120
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "Noto Sans JP",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "Roboto Mono",
          "SFMono-Regular",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "small": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    }
  }
}
