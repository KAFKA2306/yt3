{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ByosanMoneySourcePolicy",
	"description": "Zero-trust source policy for 秒算マネー. Tier 1 sources, forbidden patterns, and required state variables are machine-audited.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"domain",
		"power_macro_registry",
		"tier1_sources",
		"forbidden_patterns",
		"required_state_variables",
		"claim_rules"
	],
	"properties": {
		"schema_version": {
			"const": "byosan_money_source_policy_v1"
		},
		"domain": {
			"const": "byosan_money"
		},
		"power_macro_registry": {
			"type": "string",
			"minLength": 1
		},
		"tier1_sources": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "source_tier"],
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"source_tier": {
						"const": 1
					},
					"source_identifier": {
						"type": "string",
						"minLength": 1
					},
					"url": {
						"type": "string",
						"minLength": 1
					}
				},
				"anyOf": [
					{
						"required": ["url"]
					},
					{
						"required": ["source_identifier"]
					}
				]
			}
		},
		"forbidden_patterns": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "string",
				"minLength": 1
			}
		},
		"required_state_variables": {
			"type": "array",
			"minItems": 8,
			"uniqueItems": true,
			"items": {
				"enum": [
					"liquidity",
					"fiscal",
					"rates",
					"productivity",
					"ai_capex",
					"energy",
					"supply_chain",
					"geopolitical_regime"
				]
			}
		},
		"claim_rules": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"min_required_state_variables",
				"require_source_tier",
				"require_source_url_or_identifier",
				"require_life_impact_connection"
			],
			"properties": {
				"min_required_state_variables": {
					"const": 3
				},
				"require_source_tier": {
					"const": true
				},
				"require_source_url_or_identifier": {
					"const": true
				},
				"require_life_impact_connection": {
					"const": true
				}
			}
		}
	}
}
