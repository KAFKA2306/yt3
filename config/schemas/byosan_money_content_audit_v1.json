{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "ByosanMoneyContentAudit",
	"description": "Structured audit record for 秒算マネー content. Claims must point to Tier 1 sources and connect to state variables plus human impact.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"domain",
		"run_id",
		"audited_at",
		"decision",
		"content_items"
	],
	"properties": {
		"schema_version": {
			"const": "byosan_money_content_audit_v1"
		},
		"domain": {
			"const": "byosan_money"
		},
		"run_id": {
			"type": "string",
			"minLength": 1
		},
		"audited_at": {
			"type": "string",
			"minLength": 1
		},
		"decision": {
			"enum": ["PASS", "FAIL"]
		},
		"content_items": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"claim_id",
					"claim_text",
					"source_tier",
					"state_variables",
					"life_impact",
					"verdict"
				],
				"properties": {
					"claim_id": {
						"type": "string",
						"minLength": 1
					},
					"claim_text": {
						"type": "string",
						"minLength": 1
					},
					"source_tier": {
						"const": 1
					},
					"source_url": {
						"type": "string",
						"minLength": 1
					},
					"source_identifier": {
						"type": "string",
						"minLength": 1
					},
					"state_variables": {
						"type": "array",
						"minItems": 3,
						"uniqueItems": true,
						"items": {
							"enum": [
								"liquidity",
								"fiscal",
								"rates",
								"productivity",
								"ai_capex",
								"energy",
								"supply_chain",
								"geopolitical_regime"
							]
						}
					},
					"life_impact": {
						"type": "string",
						"minLength": 1
					},
					"forbidden_terms_found": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"verdict": {
						"enum": ["PASS", "FAIL"]
					}
				},
				"anyOf": [
					{
						"required": ["source_url"]
					},
					{
						"required": ["source_identifier"]
					}
				]
			}
		}
	}
}
