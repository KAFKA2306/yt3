{
	"name": "yt3",
	"version": "1.0.0",
	"description": "Auditable autonomous media operations for research, production, publishing, and post-publication verification.",
	"scripts": {
		"setup": "bun ci",
		"test": "bun test",
		"lint": "bun biome check .",
		"format": "bun biome format --write src tests",
		"typecheck": "bun x tsc --noEmit",
		"audit:repo-contract": "bun src/scripts/audit_repository_contract.ts",
		"audit:no-fallback:source": "bun src/scripts/audit_no_fallback_policy.ts --scope=source",
		"check:merge:fast": "bun run lint && bun run typecheck && bun run audit:repo-contract && bun src/scripts/audit_publish_routing.ts && bun run audit:no-fallback:source",
		"check:merge": "bun run check:merge:fast && SKIP_LLM=true DRY_RUN=true bun run test",
		"check:fast": "bun run check:merge:fast",
		"check": "bun run check:merge"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KAFKA2306/yt3.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"bugs": {
		"url": "https://github.com/KAFKA2306/yt3/issues"
	},
	"homepage": "https://github.com/KAFKA2306/yt3#readme",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@tsconfig/bun": "^1.0.10",
		"@tsconfig/strictest": "^2.0.8",
		"@types/bun": "^1.3.9",
		"@types/express": "^5.0.6",
		"@types/fluent-ffmpeg": "^2.1.28",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.0.9",
		"fs-extra": "^11.3.3",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@langchain/core": "^1.1.27",
		"@langchain/google-genai": "^2.1.20",
		"@langchain/langgraph": "^1.1.5",
		"@langchain/openai": "^1.2.9",
		"@types/dotenv": "^8.2.3",
		"@types/serve-index": "^1.9.4",
		"@types/sharp": "^0.31.1",
		"axios": "^1.13.5",
		"discord.js": "^14.25.1",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"express-handlebars": "^8.0.3",
		"express-rate-limit": "^7.1.5",
		"fluent-ffmpeg": "^2.1.3",
		"googleapis": "^170.1.0",
		"htmx.org": "^2.0.8",
		"js-yaml": "^4.1.1",
		"serve-index": "^1.9.2",
		"sharp": "^0.34.5",
		"twitter-api-v2": "^1.29.0",
		"zod": "^4.3.6"
	}
}
