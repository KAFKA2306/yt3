{
	"name": "yt3",
	"version": "1.0.0",
	"description": "Auditable autonomous media operations for research, production, publishing, and post-publication verification.",
	"scripts": {
		"setup": "bun ci",
		"test": "bun test",
		"lint": "bun node_modules/@biomejs/biome/bin/biome check .",
		"format": "bun node_modules/@biomejs/biome/bin/biome format --write src tests",
		"typecheck": "tsc --noEmit",
		"design:preview": "bun src/scripts/design_preview.ts",
		"check:merge:fast": "bun run lint && bun run typecheck && bun src/scripts/audit_publish_routing.ts",
		"check:merge": "bun run check:merge:fast && SKIP_LLM=true DRY_RUN=true bun run test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KAFKA2306/yt3.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "module",
	"bugs": {
		"url": "https://github.com/KAFKA2306/yt3/issues"
	},
	"homepage": "https://github.com/KAFKA2306/yt3#readme",
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@tsconfig/bun": "^1.0.10",
		"@tsconfig/strictest": "^2.0.8",
		"@types/bun": "^1.3.9",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.0.9",
		"fs-extra": "^11.3.3",
		"typescript": "^7.0.2",
		"typescript-5": "npm:typescript@^5.9.3"
	},
	"dependencies": {
		"@langchain/core": "^1.1.27",
		"@langchain/google-genai": "^2.1.20",
		"discord.js": "^14.27.0",
		"dotenv": "^17.3.1",
		"echarts": "6.1.0",
		"googleapis": "^170.1.0",
		"js-yaml": "^4.3.2",
		"sharp": "^0.35.5",
		"twitter-api-v2": "^1.29.0",
		"zod": "^4.3.6"
	},
	"overrides": {
		"qs": "^6.16.0",
		"brace-expansion": "^2.1.7",
		"undici": "^6.29.0"
	}
}
